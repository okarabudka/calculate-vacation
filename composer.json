{
    "name": "okarabudka/php-calculate-vacation",
    "type": "project",
    "description": "PHP calculate-vacation tasks",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Karabudka",
            "email": "sanyakarabudka@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/clock": "^1.0",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M --no-progress",
        "cs": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
